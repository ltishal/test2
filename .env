# ─── Ваша модель ──────────────────────────────────────────────────────
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5:7b

# ─── Модель: главное узкое место при нескольких игроках ───────────────
# Сколько запросов к модели обрабатывается одновременно.
# Согласуйте с OLLAMA_NUM_PARALLEL (для Ollama) — иначе очередь станет
# невидимой и будет вести себя непредсказуемо.
LLM_MAX_CONCURRENT=2
# Сколько секунд запрос может ждать своей очереди, прежде чем отдать ошибку.
LLM_QUEUE_TIMEOUT=120

# ─── Служебные вызовы: извлечение состояния и резюме ──────────────────
# Их можно увести на модель полегче — будет заметно быстрее.
# Сначала скачайте модель:  ollama pull qwen2.5:3b
# Если строки закомментированы, используется OPENAI_MODEL.
# EXTRACT_MODEL=qwen2.5:3b
# SUMMARY_MODEL=qwen2.5:3b

# Сколько партий держать в памяти сервера вместе с их резюме.
SUMMARY_MAX_SESSIONS=128

# ─── Прокси ───────────────────────────────────────────────────────────
# 1 — доверять заголовку X-Forwarded-For (только если перед приложением
# стоит ваш nginx). 0 — брать адрес напрямую, иначе лимит частоты
# обходится подстановкой заголовка.
TRUST_PROXY=0

# ─── Портрет персонажа ────────────────────────────────────────────────
# Порядок провайдеров. Первый успешный выигрывает.
AVATAR_PROVIDERS=pollinations,static
AVATAR_SIZE=512
# Таймаут одного сетевого вызова. Держите ниже 90 с — это таймаут в браузере.
AVATAR_TIMEOUT=60

# Дисковый кэш: общий для воркеров, переживает рестарт.
# Относительный путь считается от папки проекта.
AVATAR_CACHE_DIR=saves/avatars
AVATAR_MEM_CACHE=64

# Одновременных обращений к провайдерам картинок.
AVATAR_MAX_CONCURRENT=2
# Лимит на IP: 20 запросов за час. 0 — выключить.
AVATAR_RATE_LIMIT=20
AVATAR_RATE_WINDOW=3600

POLLINATIONS_MODEL=flux

# ─── Опционально: локальный SD (если есть GPU) ────────────────────────
# AVATAR_PROVIDERS=local,pollinations,static
# AVATAR_LOCAL_URL=http://127.0.0.1:7860
# AVATAR_LOCAL_STEPS=24
# AVATAR_LOCAL_CFG=6.0

# ─── Опционально: Hugging Face ────────────────────────────────────────
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ─── Опционально: нестабильные адаптеры ───────────────────────────────
# HORDE_KEY=0000000000
# PERCHANCE_USER_KEY=
# BING_COOKIE_U=