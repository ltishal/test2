# ─── Модель мастера ───────────────────────────────────────────────────
# Локально (Ollama):
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5:7b

# На Railway вместо трёх строк выше — облачный провайдер, например:
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=qwen/qwen-2.5-72b-instruct

# ─── Лимит параллельных обращений к модели ────────────────────────────
# Главное узкое место при нескольких игроках. Согласуйте с
# OLLAMA_NUM_PARALLEL (для Ollama) — иначе очередь станет невидимой.
LLM_MAX_CONCURRENT=2
LLM_QUEUE_TIMEOUT=120

# ─── Служебные вызовы: извлечение состояния и резюме ──────────────────
# Их можно увести на модель полегче — будет заметно быстрее.
# Сначала скачайте модель:  ollama pull qwen2.5:3b
# Если строки закомментированы, используется OPENAI_MODEL.
# EXTRACT_MODEL=qwen2.5:3b
# SUMMARY_MODEL=qwen2.5:3b

# Сколько партий держать в памяти сервера вместе с их резюме.
SUMMARY_MAX_SESSIONS=128
